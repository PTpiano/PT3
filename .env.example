# ═══════════════════════════════════════════════════════════════
# Variabili d'ambiente — copia questo file in .env.local e compila.
# Su Vercel: Project Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════

# ── Database (obbligatorio in produzione) ────────────────────────
# PostgreSQL gestito (Neon, Vercel Postgres, Railway, ecc.).
# In locale, se manca, il sito usa PGlite in-process (.data/pglite).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Auth admin (obbligatorio) ────────────────────────────────────
# Segreto per firmare i JWT dell'admin (stringa casuale lunga almeno 32
# caratteri: `openssl rand -hex 32`).
AUTH_SECRET=cambia-questo-con-una-stringa-casuale-lunga
# Credenziali del pannello /admin
ADMIN_EMAIL=admin@esempio.com
ADMIN_PASSWORD=cambia-questo

# ── Storage file (obbligatorio in produzione) ────────────────────
# Vercel Blob: Blob → Create Blob Store → copia il token.
# In locale, se manca, i file finiscono in public/uploads/.
BLOB_READ_WRITE_TOKEN=

# ── Pagamenti Stripe (opzionale: senza, lo shop non accetta ordini) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Esterni (opzionali) ──────────────────────────────────────────
# Feed YouTube nella pagina /social
YOUTUBE_API_KEY=
# Embed e link vari
NEXT_PUBLIC_SPOTIFY_ARTIST_ID=
NEXT_PUBLIC_SOUNDCLOUD_URL=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
# Dominio pubblico usato nei redirect Stripe (es. https://miosito.com)
NEXT_PUBLIC_SITE_URL=
